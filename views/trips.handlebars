<h2>Trips</h2>

{{#if trips.length}}

    {{#each trips}}

        <div class="trip">

            <h3>Trip #{{id}}</h3>

            <p>
                Passenger: {{passenger_name}}
            </p>

            <p>
                Driver:
                {{#if driver_name}}
                    {{driver_name}}
                {{else}}
                    Not assigned
                {{/if}}
            </p>

            <p>
                From: {{pickup_address}}
            </p>

            <p>
                To: {{destination_address}}
            </p>

            <p>
                Distance: {{distance}} km
            </p>

            <p>
                Price: {{price}} KZT
            </p>

            <p>
                Status: {{status}}
            </p>

        </div>

    {{/each}}

{{else}}

    <p>No trips yet.</p>

{{/if}}