  note: 'Cleaned charges. Excludes voided rows.'
}

Table fct_orders {
  order_id integer [pk]
  amount decimal
  state varchar
  ordered_at timestamp
  note: 'One row per order.'
}

// ── Core: column lineage + the SQL that produces it ──
Dep {
  stg_orders.order_id   -> fct_orders.order_id
  stg_orders.amount     -> fct_orders.amount
  stg_orders.status     -> fct_orders.state
  stg_orders.created_at -> fct_orders.ordered_at

  note: '''
    Materialized as a table.
    Maps status -> state; keeps paid orders.

    \`\`\`sql
    SELECT order_id, amount, created_at AS ordered_at,
           CASE WHEN status = 'paid'
                THEN 'complete' ELSE status END AS state
    FROM stg_orders
    \`\`\`
  '''
}

Table mart_revenue {
  month date [pk]
  revenue decimal
  order_count integer
  note: 'Monthly revenue for the finance dashboard.'
}

// ── Mart: every column says what it is built from ──
Dep {
  fct_orders.ordered_at -> mart_revenue.month
  fct_orders.amount     -> mart_revenue.revenue
  fct_orders.order_id   -> mart_revenue.order_count

  note: '''
    One row per month, aggregated from fct_orders.

    \`\`\`sql
    SELECT date_trunc('month', ordered_at)::date AS month,
           SUM(amount) AS revenue,
           COUNT(*)    AS order_count
    FROM fct_orders
    WHERE state = 'complete'
    GROUP BY 1
    \`\`\`
  '''
}
